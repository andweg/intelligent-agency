---
import '../styles/global.css'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import { SITE } from '../site.config'
import { withBase } from '../lib/url'

interface Props {
  title: string
  description?: string
  /** Week pages lay out their own sidebar + content grid, so they opt out of the narrow wrapper. */
  wide?: boolean
}

const { title, description = SITE.description, wide = false } = Astro.props

const pageTitle = title === SITE.name ? title : `${title} — ${SITE.name}`
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://example.com').href
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="generator" content={Astro.generator} />

    {/* Set the theme before first paint. The one place an inline script is warranted.
        Light is the default; only an explicit stored choice moves off it. */}
    <script is:inline>
      ;(function () {
        var theme = 'light'
        try {
          var stored = localStorage.getItem('uia:theme')
          if (stored === 'dark' || stored === 'light') theme = stored
        } catch (e) {
          /* storage blocked: keep the light default */
        }
        document.documentElement.dataset.theme = theme
      })()
    </script>
  </head>

  <body class="bg-paper text-ink min-h-screen">
    <a
      href="#main"
      class="bg-accent text-accent-contrast focus:ring-accent sr-only rounded-[4px] px-4 py-2 focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50"
    >
      Skip to content
    </a>

    <Header />

    <main id="main" class:list={[wide ? '' : 'mx-auto max-w-[1240px] px-4 sm:px-6']}>
      <slot />
    </main>

    <Footer />
  </body>
</html>
