---
/**
 * Clears what the site has stored in this browser. Two independent controls, each behind its own
 * two-step confirm, because progress and notes are different things to lose: one is a row of
 * ticks you can redo in a minute, the other is writing you cannot get back.
 *
 * Hidden entirely when JavaScript is off, since nothing was persisted in that case.
 */

// Everything that differs between the two controls lives here, so the behaviour below is written
// once. `key` is the localStorage key each button clears.
const controls = [
  {
    id: 'progress',
    key: 'uia:progress',
    heading: 'Reset reading progress',
    description:
      'Unticks every reading across all nine weeks. Your notes are left alone. This cannot be undone.',
    confirm: 'Untick every reading?',
    action: 'Reset progress',
    done: 'Reading progress cleared.',
  },
  {
    id: 'notes',
    key: 'uia:notes',
    heading: 'Delete your notes',
    description:
      'Deletes everything you have written in the notes panel on every week. Your ticked readings are left alone. This cannot be undone.',
    confirm: 'Delete the notes for all nine weeks?',
    action: 'Delete notes',
    done: 'Notes deleted.',
  },
] as const

const btn =
  'meta border-rule hover:bg-surface rounded-[4px] border px-4 py-2 uppercase transition-colors'
const btnDanger =
  'meta bg-accent text-accent-contrast hover:bg-accent-hover rounded-[4px] px-4 py-2 uppercase transition-colors'
---

<section id="reset-storage" hidden class="border-rule mt-10 border-t pt-8">
  <h2 class="text-[1.15rem]">Stored in this browser</h2>
  <p class="text-muted mt-1.5 max-w-[60ch] text-[0.9rem] leading-relaxed">
    Both are kept only on this device and are never sent anywhere. They are cleared separately, so
    resetting one leaves the other in place.
  </p>

  <div class="mt-6 space-y-7">
    {controls.map((control) => (
      <div data-reset={control.key}>
        <h3 class="text-[0.98rem] font-semibold">{control.heading}</h3>
        <p class="text-muted mt-1 max-w-[60ch] text-[0.9rem] leading-relaxed">
          {control.description}
        </p>

        <div class="mt-3 flex flex-wrap items-center gap-3">
          <button type="button" class={btn} data-reset-start>
            {control.action}
          </button>

          <span hidden class="flex flex-wrap items-center gap-3" data-reset-confirm>
            <span class="text-[0.9rem]">{control.confirm}</span>
            <button type="button" class={btnDanger} data-reset-yes>
              Yes, {control.action.toLowerCase()}
            </button>
            <button type="button" class={btn} data-reset-no>
              Cancel
            </button>
          </span>

          <span hidden class="text-muted text-[0.9rem]" data-reset-done>
            {control.done}
          </span>
        </div>
      </div>
    ))}
  </div>
</section>

<script>
  const section = document.getElementById('reset-storage')
  if (section) {
    // Only offer the controls where there is storage to clear.
    section.hidden = false

    for (const group of section.querySelectorAll<HTMLElement>('[data-reset]')) {
      const key = group.dataset.reset
      const start = group.querySelector<HTMLButtonElement>('[data-reset-start]')
      const confirm = group.querySelector<HTMLElement>('[data-reset-confirm]')
      const yes = group.querySelector<HTMLButtonElement>('[data-reset-yes]')
      const no = group.querySelector<HTMLButtonElement>('[data-reset-no]')
      const done = group.querySelector<HTMLElement>('[data-reset-done]')
      if (!key || !start || !confirm || !yes || !no || !done) continue

      start.addEventListener('click', () => {
        start.hidden = true
        done.hidden = true
        confirm.hidden = false
        yes.focus()
      })

      no.addEventListener('click', () => {
        confirm.hidden = true
        start.hidden = false
        start.focus()
      })

      yes.addEventListener('click', () => {
        try {
          localStorage.removeItem(key)
        } catch {
          // Storage blocked: there was nothing persisted to clear anyway.
        }
        confirm.hidden = true
        start.hidden = false
        done.hidden = false
        start.focus()
      })
    }
  }
</script>
