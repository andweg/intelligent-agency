---
import ThemeToggle from './ThemeToggle.astro'
import Mark from './Mark.astro'
import { SITE } from '../site.config'
import { withBase } from '../lib/url'

const path = Astro.url.pathname.replace(/\/$/, '')

const links = [
  { href: '/about', label: 'About' },
  { href: '/your-data', label: 'Your data' },
]
---

<header class="border-rule bg-paper sticky top-0 z-30 border-b">
  <div class="mx-auto flex h-16 max-w-[1240px] items-center gap-4 px-4 sm:px-6">
    <a href={withBase('/')} class="flex items-center gap-2.5">
      <Mark size={26} class="text-accent" />
      {/* The full wordmark does not fit beside the nav on a narrow phone, so below `sm` the mark
          carries the identity on its own and the name stays for screen readers. */}
      <span class="font-serif sr-only text-[17px] leading-none font-semibold tracking-[-0.01em] sm:not-sr-only md:text-[19px]">
        {SITE.name}
      </span>
    </a>

    <nav aria-label="Main" class="ml-auto flex items-center gap-2 sm:gap-3">
      {/* The links sit flush against each other so the hairline between them lands in the middle
          of their shared padding. The negative margin cancels the outer padding, leaving the row
          aligned as if the links carried none. */}
      <div class="-mx-2.5 flex items-center sm:-mx-3">
        {links.map((link, index) => {
          const isCurrent = path.endsWith(link.href)
          return (
            <a
              href={withBase(link.href)}
              aria-current={isCurrent ? 'page' : undefined}
              class:list={[
                'meta px-2.5 py-1.5 whitespace-nowrap uppercase transition-colors sm:px-3',
                index > 0 && 'border-rule border-l',
                isCurrent ? 'text-accent' : 'text-muted hover:text-ink',
              ]}
            >
              {link.label}
            </a>
          )
        })}
      </div>

      <ThemeToggle />
    </nav>
  </div>
</header>
