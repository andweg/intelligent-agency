---
import { SITE } from '../site.config'
import { withBase } from '../lib/url'

interface Props {
  class?: string
  variant?: 'solid' | 'outline'
}

const { class: className = '', variant = 'solid' } = Astro.props
---

<a
  href={withBase('/signup')}
  class:list={['btn', variant === 'outline' && 'btn--quiet', className]}
>
  {SITE.signupLabel}
</a>
