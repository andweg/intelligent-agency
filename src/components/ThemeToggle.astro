---
/**
 * Theme toggle. The inline script in BaseLayout sets data-theme before first paint; this button
 * flips it and records the choice. With JS off the button simply does nothing, and the OS
 * preference still applies via prefers-color-scheme.
 */
---

<button
  type="button"
  id="theme-toggle"
  class="border-rule text-muted hover:text-ink hover:bg-surface inline-flex size-8 items-center justify-center rounded-[4px] border transition-colors"
  aria-label="Switch to dark theme"
>
  <svg
    class="icon-light size-[18px]"
    viewBox="0 0 20 20"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    aria-hidden="true"
  >
    <path d="M16.5 11.8A7 7 0 0 1 8.2 3.5a7 7 0 1 0 8.3 8.3Z"></path>
  </svg>
  <svg
    class="icon-dark size-[18px]"
    viewBox="0 0 20 20"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    aria-hidden="true"
  >
    <circle cx="10" cy="10" r="3.75"></circle>
    <path d="M10 1.5v2M10 16.5v2M18.5 10h-2M3.5 10h-2M15.95 4.05l-1.4 1.4M5.45 14.55l-1.4 1.4M15.95 15.95l-1.4-1.4M5.45 5.45l-1.4-1.4"></path>
  </svg>
</button>

<script>
  const STORAGE_KEY = 'uia:theme'

  function currentTheme(): 'light' | 'dark' {
    return document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light'
  }

  function syncLabel(button: HTMLButtonElement) {
    const next = currentTheme() === 'dark' ? 'light' : 'dark'
    button.setAttribute('aria-label', `Switch to ${next} theme`)
  }

  const button = document.getElementById('theme-toggle')
  if (button instanceof HTMLButtonElement) {
    syncLabel(button)
    button.addEventListener('click', () => {
      const next = currentTheme() === 'dark' ? 'light' : 'dark'
      document.documentElement.dataset.theme = next
      try {
        localStorage.setItem(STORAGE_KEY, next)
      } catch {
        // Private browsing or blocked site data: the choice just will not persist.
      }
      syncLabel(button)
    })
  }
</script>
