---
import BaseLayout from '../layouts/BaseLayout.astro'
import { getCourse } from '../lib/course'
import { SITE } from '../site.config'

const course = await getCourse()

const embedSrc = `https://tally.so/embed/${SITE.tallyFormId}?alignLeft=1&hideTitle=1&transparentBackground=0&dynamicHeight=1`
// Tally serves the same form standalone at /r/<id>. Used for the no-JavaScript fallback, since
// the embed only loads once its loader script has run.
const standaloneUrl = `https://tally.so/r/${SITE.tallyFormId}`
---

<BaseLayout
  title="Join a cohort"
  description={`Sign up for the next cohort of the ${course.data.title} reading and discussion group.`}
>
  <article class="max-w-[720px] py-14 sm:py-20">
    <p class="eyebrow">Signup</p>
    <h1 class="mt-3 text-[2rem] leading-[1.15] sm:text-[2.45rem]">Join a cohort</h1>

    <div class="border-rule mt-8 border-t pt-8">
      {/* `src` is set here rather than left to Tally's `data-tally-src`: their loader only swaps
          it in from an IntersectionObserver, which leaves this iframe blank until it happens to
          fire. Their script still picks up an already-sourced iframe and drives dynamicHeight, so
          the form loads immediately and still resizes itself.

          The vendor snippet's frameborder/marginheight/marginwidth are HTML4 no-ops; Tailwind's
          preflight already zeroes the iframe border. The height below is only the starting box. */}
      <iframe
        src={embedSrc}
        loading="lazy"
        width="100%"
        height="900"
        class="block w-full"
        title={`${course.data.title} reading group`}
      ></iframe>

      <noscript>
        <p class="text-muted mt-4 leading-relaxed">
          Signup forms need JavaScript, in this page or anywhere else. With it switched off,{' '}
          <a
            href={standaloneUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="text-accent underline underline-offset-2"
          >
            the form on tally.so
          </a>{' '}
          is the same one.
        </p>
      </noscript>
    </div>
  </article>

  {/* Tally's loader, verbatim and inline: it injects their embed.js, which swaps data-tally-src
      onto src and resizes the iframe. Inline and unbundled so it stays exactly as the vendor
      ships it. This page is the only one on the site that makes a third-party request. */}
  <script is:inline>
    var d = document,
      w = 'https://tally.so/widgets/embed.js',
      v = function () {
        'undefined' != typeof Tally
          ? Tally.loadEmbeds()
          : d.querySelectorAll('iframe[data-tally-src]:not([src])').forEach(function (e) {
              e.src = e.dataset.tallySrc
            })
      }
    if ('undefined' != typeof Tally) v()
    else if (d.querySelector('script[src="' + w + '"]') == null) {
      var s = d.createElement('script')
      ;((s.src = w), (s.onload = v), (s.onerror = v), d.body.appendChild(s))
    }
  </script>
</BaseLayout>
