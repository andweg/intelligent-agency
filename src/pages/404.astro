---
import BaseLayout from '../layouts/BaseLayout.astro'
import { getWeeks } from '../lib/course'
import { withBase } from '../lib/url'
import { weekHref } from '../lib/links'

const weeks = await getWeeks()
---

<BaseLayout title="Page not found" description="That page does not exist on this site.">
  <div class="max-w-[720px] py-20 sm:py-28">
    <p class="eyebrow">404</p>
    <h1 class="mt-3 text-[2rem] leading-[1.15] sm:text-[2.45rem]">That page does not exist</h1>
    <p class="text-muted mt-3 leading-relaxed">
      The link may be out of date, or the page may have moved.
    </p>

    <div class="mt-7 flex flex-wrap gap-3">
      <a
        href={withBase('/')}
        class="meta bg-accent text-accent-contrast hover:bg-accent-hover inline-flex items-center justify-center rounded-[4px] px-5 py-2.5 uppercase transition-colors"
      >
        Go to the course page
      </a>
      <a
        href={withBase('/about')}
        class="meta border-rule hover:bg-surface inline-flex items-center justify-center rounded-[4px] border px-5 py-2.5 uppercase transition-colors"
      >
        About this site
      </a>
    </div>

    <nav aria-label="Weeks" class="border-rule mt-12 border-t pt-8">
      <h2 class="meta-sm text-muted uppercase">All weeks</h2>
      <ul class="mt-4 space-y-1.5">
        {weeks.map((week) => (
          <li>
            <a
              href={weekHref(week.data.week)}
              class="hover:text-accent text-[0.92rem] transition-colors"
            >
              <span class="meta text-muted">{String(week.data.week).padStart(2, '0')}</span>{' '}
              {week.data.title}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</BaseLayout>
